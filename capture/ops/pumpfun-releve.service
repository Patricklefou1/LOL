[Unit]
Description=Releve hors echantillon de la borne d'ancrage (protocoles v1, v2, v3)
Documentation=file:/opt/pumpfun/bin/releve-borne-ancrage.sh
After=clickhouse-server.service pumpfun-derivees.service
Wants=clickhouse-server.service

[Service]
Type=oneshot
User=pumpfun
ExecStart=/opt/pumpfun/bin/releve-borne-ancrage.sh
Nice=15
IOSchedulingClass=idle
CPUWeight=15
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
