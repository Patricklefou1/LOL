# Endpoint gRPC Triton (Yellowstone / Dragon's Mouth)
GRPC_ENDPOINT=https://your-endpoint.rpcpool.com:443
GRPC_X_TOKEN=votre-x-token

# processed = latence minimale (recommandé pour la capture)
COMMITMENT=processed

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=pumpfun

# Archiver les transactions brutes re-décodables (recommandé : 1)
CAPTURE_RAW=1

# Contexte d'exécution (tables tx_costs et sol_transfers) : priority fees, tips
# Jito, taux d'échec, flux SOL. Socle du modèle de coûts et des empreintes de devs.
CAPTURE_EXECUTION=1

# Capturer aussi les transactions échouées (leur taux est une entrée du modèle
# de coûts). Leur archive brute est désactivée par défaut : elles n'ont aucun
# événement à re-décoder, et le brut est le poste disque n°1.
CAPTURE_FAILED=1
CAPTURE_RAW_FAILED=0

# Endpoint HTTP JSON-RPC pour la réconciliation des trous (npm run reconcile).
# Celui du plan Triton convient ; la latence n'a aucune importance ici.
RPC_URL=https://your-endpoint.rpcpool.com
