{
  "name": "pumpfun-capture",
  "version": "0.1.0",
  "private": true,
  "description": "Capture du programme Pump.fun via Triton Yellowstone gRPC vers ClickHouse (phase 1 du plan d'ex\u00e9cution)",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "labels": "tsx src/labels.ts",
    "reconcile": "tsx src/reconcile.ts",
    "profiles": "tsx src/profiles.ts"
  },
  "dependencies": {
